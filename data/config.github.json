{
  "ai": {
    "analysis_concurrency": 5,
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "enrichment_concurrency": 5,
    "languages": [
      "zh",
      "en"
    ],
    "max_tokens": 8192,
    "model": "deepseek-chat",
    "provider": "deepseek",
    "temperature": 0.3,
    "throttle_sec": 1
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null,
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "tech-blog"
    ]
  },
  "processing": {
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    },
    "profiles_dir": "profiles"
  },
  "sources": {
    "github": [
      {
        "enabled": true,
        "owner": "vllm-project",
        "profile": "tech-news",
        "repo": "vllm",
        "type": "repo_releases"
      },
      {
        "enabled": true,
        "owner": "sgl-project",
        "profile": "tech-news",
        "repo": "sglang",
        "type": "repo_releases"
      },
      {
        "enabled": true,
        "owner": "triton-lang",
        "profile": "tech-news",
        "repo": "triton",
        "type": "repo_releases"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "reddit": {
      "enabled": true,
      "fetch_comments": 10,
      "subreddits": [
        {
          "enabled": true,
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news",
          "sort": "hot",
          "subreddit": "MachineLearning",
          "time_filter": "day"
        },
        {
          "enabled": true,
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news",
          "sort": "hot",
          "subreddit": "LocalLLaMA",
          "time_filter": "day"
        }
      ],
      "users": []
    },
    "rss": [
      {
        "category": "ai-tools",
        "enabled": true,
        "name": "Simon Willison",
        "profile": "tech-news",
        "url": "https://simonwillison.net/atom/everything/"
      },
      {
        "category": "llm-inference",
        "content_extractor": "trafilatura",
        "enabled": true,
        "name": "vLLM Blog",
        "profile": "tech-blog",
        "url": "https://vllm.ai/blog/rss.xml"
      },
      {
        "category": "github-trending",
        "enabled": true,
        "name": "GitHub Trending - Daily",
        "profile": "tech-news",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml"
      },
      {
        "category": "semiconductors",
        "enabled": true,
        "name": "Semianalysis",
        "profile": "tech-news",
        "url": "https://newsletter.semianalysis.com/feed"
      }
    ],
    "telegram": {
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": "tech-news"
        }
      ],
      "enabled": true
    }
  }
}